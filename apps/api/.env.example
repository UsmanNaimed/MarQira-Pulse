APP_NAME="MarQira Pulse API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.marqira.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=marqira-postgres
DB_PORT=5432
DB_DATABASE=marqira_pulse
DB_USERNAME=marqira_app
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

REDIS_CLIENT=predis
REDIS_HOST=marqira-redis
REDIS_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
REDIS_PORT=6379

CACHE_DRIVER=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

# ---------------------------------------------------------------------------
# Dashboard SPA authentication (Sanctum stateful cookie session)
# ---------------------------------------------------------------------------
# The dashboard (app.marqira.com) and API (api.marqira.com) share the parent
# domain so the session cookie is sent on cross-subdomain XHR requests.
SESSION_DOMAIN=.marqira.com
# Only serve the session cookie over HTTPS in production.
SESSION_SECURE_COOKIE=true
# Domains allowed to authenticate statefully (comma-separated, no scheme).
SANCTUM_STATEFUL_DOMAINS=app.marqira.com
# Browser origins allowed by CORS (comma-separated, include scheme).
# For local dev use http://localhost:5173
CORS_ALLOWED_ORIGINS=https://app.marqira.com

# Latest connector release version — drives the "Updates available" card on the
# dashboard overview. Defaults to the currently shipped connector (1.2.0) when
# unset; override here when a newer connector is published.
MARQIRA_PLUGIN_LATEST_VERSION=1.2.0

# Encryption key for site secrets (32 random bytes, base64-encoded)
# Generate with: php -r "echo base64_encode(random_bytes(32));"
MARQIRA_SECRET_KEY=REPLACE_WITH_GENERATED_KEY

# Internal API — trusted proxy (Coolify/Traefik Docker subnet)
TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8

# Initial allowed MarQira infrastructure IP for n8n and plugin
MARQIRA_ALLOWED_IPS=187.77.136.105
