FROM php:8.3-fpm-alpine AS dev

# Install system dependencies
RUN apk add --no-cache \
    git curl zip unzip \
    postgresql-dev \
    libzip-dev \
    oniguruma-dev \
    icu-dev \
    && docker-php-ext-install \
        pdo pdo_pgsql \
        zip \
        mbstring \
        intl \
        opcache \
        pcntl

# Install Redis extension
RUN apk add --no-cache $PHPIZE_DEPS \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && apk del $PHPIZE_DEPS

# Install Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

# Development container: install ALL dependencies (including dev) and skip
# cache warming. The application source is bind-mounted via docker-compose, so
# no COPY of the app is performed here — edits are reflected live.
COPY composer.json composer.lock ./

RUN composer install --no-scripts --no-autoloader --prefer-dist

EXPOSE 9000

CMD ["php-fpm"]
