# Base URL of the MarQira Pulse API (leave empty to use same-origin / dev proxy).
# In production the dashboard is served from app.marqira.com and talks to
# https://api.marqira.com, so set this to that origin.
VITE_API_BASE_URL=https://api.marqira.com

# Local dev only: where the Vite proxy forwards /api and /sanctum.
# VITE_DEV_API_TARGET=http://localhost:8000
